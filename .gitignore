```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
pip-wheel-metadata/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
.coverage
coverage/
htmlcov/

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
*.egg-info/

# Testing
.pytest_cache/
.mypy_cache/
```